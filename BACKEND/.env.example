# MajiSmart Zambia Environment Configuration
# Direct Supabase writes are relayed to SSE. Optional server-only Supabase URL /
# service role credentials below enable push events when tables are published.
# The small tank-state fallback check runs only while SSE viewers are connected.
TELEMETRY_CHANGE_CHECK_MS=2000
PORT=5000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# PostgreSQL is required for production. SQLite remains the local test default.
DB_MODE=sqlite
# Production: Supabase Supavisor *transaction pooler* string, e.g.
# postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Security Keys
JWT_SECRET=replace-with-a-long-random-secret
IOT_API_KEY=replace-with-a-random-device-key
SEED_ADMIN_PASSWORD=replace-before-first-production-start
SEED_CUSTOMER_PASSWORD=replace-before-first-production-start

# Supabase project credentials (the backend uses the direct PostgreSQL URL).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Supabase pooler connection string; set DATABASE_URL in production.
SUPABASE_DB_URL=
TEST_DATABASE_URL=

# Schema migrations: when NODE_ENV=production the API never runs DDL at boot unless
# AUTO_MIGRATE=true. Apply migrations with `supabase db push` instead.
AUTO_MIGRATE=false

# Database pool (keep small when using the Supabase pooler)
DB_POOL_MAX=5
DB_STATEMENT_TIMEOUT_MS=15000

# Trust X-Forwarded-For from one proxy hop (Fly.io / Render / Cloudflare)
TRUST_PROXY_HOPS=1

# SSE keepalive interval; managed proxies drop silent streams after ~60s
SSE_HEARTBEAT_MS=25000

# Stale Device Threshold (seconds before device marked OFFLINE)
DEVICE_OFFLINE_TIMEOUT_SECONDS=60

# Optional Open-Meteo or OpenWeather API
WEATHER_CITY=Lusaka
WEATHER_COUNTRY=Zambia

