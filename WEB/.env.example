# Use /api when the web app is served by the backend or locally through Vite.
# For Cloudflare Pages, set this to the public Render API origin plus /api.
VITE_API_BASE_URL=/api

# Direct ESP32 -> Supabase Edge Function readings (optional; configure both).
# Use the SAME Supabase project as the ESP32 receive-reading URL.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Verify the actual Edge Function destination table before setting this.
VITE_SUPABASE_READINGS_TABLE=water_level_readings

