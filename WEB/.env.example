# Base URL for the shared API.
#
# Local dev: leave as /api (vite.config.js proxies /api to http://localhost:5000).
# Deployed:  the SPA and API are on different hosts, so this MUST be an absolute URL.
#            VITE_API_BASE_URL=https://api.majismart.zm/api
#
# This value is inlined at build time by Vite — changing it requires a rebuild.
VITE_API_BASE_URL=/api

# Google Identity Services client id (Web application) from Google Cloud Console.
# Optional at build time: the deployed client id is baked in as a fallback, and
# this variable overrides it when set. A malformed value is ignored.
VITE_GOOGLE_CLIENT_ID=
